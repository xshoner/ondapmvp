CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_FRONT_API_KEY=
CAFE24_REDIRECT_URI=
CAFE24_SCOPE=mall.read_product
CAFE24_API_VERSION=
# 운영 빌드에서 로그인 없이 관리자 화면을 열 때만 1 (권장하지 않음)
ONDAP_ALLOW_LOCAL_ADMIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local | supabase
ONDAP_DATA_SOURCE=local
# AI 점수 제안 (Gemini). 키는 Vercel에도 같은 이름으로 등록
ondap_ai=
ONDAP_AI_MODEL=gemini-3.6-flash
# 기본 모델이 계속 실패할 때 쓸 대체 모델 (빈 값이면 사용 안 함)
ONDAP_AI_FALLBACK_MODEL=gemini-flash-latest
# 자체 도메인을 붙였을 때만: 공유 그림·링크·검색엔진 안내의 기준 주소 (비우면 Vercel 운영 주소)
NEXT_PUBLIC_SITE_URL=
# 예약 작업/운영 기록 전용. NEXT_PUBLIC_ 접두어를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 32자 이상 무작위 값. Vercel Cron이 Authorization: Bearer 헤더로 전달한다.
CRON_SECRET=
